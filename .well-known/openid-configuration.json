    "profile",
    "email",
    "read:services",
    "write:appointments",
    "write:newsletter"
  ],
  "bearer_methods_supported": [
    "header"
  ],
  "token_endpoint_auth_methods_supported": [
    "client_secret_basic",
    "client_secret_post",
    "private_key_jwt"
  ],
  "agent_auth": {
